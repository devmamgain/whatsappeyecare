{
  "name": "whatsapp-booking-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Rule-based WhatsApp appointment booking chatbot (Meta Cloud API, Express, Prisma, PostgreSQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.0.0"
  }
}
